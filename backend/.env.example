# Askit RAG — environment template.
# Copy to .env and fill in your own values:
#   cp .env.example .env
#
# Required keys are listed first; OPTIONAL ones have sensible defaults and
# can be left commented out unless you want to override them.

# === REQUIRED ===

# Fireworks LLM (OpenAI-compatible API). Base URL must be the ROOT path —
# do not append /chat/completions or /embeddings, LangChain adds them.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL_NAME=

# Qdrant Cloud credentials. Local mode: set QDRANT_URL=:memory: and leave
# QDRANT_API_KEY blank (only works if you point at a local QdrantClient).
QDRANT_URL=
QDRANT_API_KEY=

# Opik observability — find these in your Opik workspace settings.
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=Askit

# Auth — JWT signing secret (any long random string). Required.
#   e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=


# === OPTIONAL — defaults shown; uncomment to override ===

# Qdrant collection name and request timeout (seconds). The default collection
# matches the Fireworks embeddings dim (auto-probed); change the name if you
# swap embedding models so the old dim-incompatible collection isn't reused.
# QDRANT_COLLECTION=askit-docs-fireworks
# QDRANT_TIMEOUT=60

# Chunking (chars).
# CHUNK_SIZE=850
# CHUNK_OVERLAP=100
# INGEST_BATCH_SIZE=16

# Dense embeddings via the Fireworks API (OpenAI-compatible embeddings
# endpoint, same base URL + key as the LLM). Set to any Fireworks embedding id.
# Cloud Reranker API (defaults to Fireworks Qwen3 Reranker).
# Set FIREWORKS_API_KEY_O if using a separate key for Fireworks reranking
# while using Nebius / other providers for the main LLM.
# FIREWORKS_API_KEY_O=
# FIREWORKS_RERANK_URL=https://api.fireworks.ai/inference/v1/rerank
# RERANKER_MODEL_NAME=accounts/fireworks/models/qwen3-reranker-8b

# --- Vision extraction (scanned PDFs / image uploads) ---
# Optional Fireworks vision model id. Same base URL as the text LLM. Leave
# blank for text-only ingestion. Examples:
#   accounts/fireworks/models/llama-v3p2-11b-vision-instruct
#   accounts/fireworks/models/qwen2-vl-72b-instruct
FIREWORKS_VISION_MODEL_NAME=
# A page with fewer extracted chars than this is treated as scanned.
# VISION_MIN_CHARS=50
# VISION_RENDER_DPI=200

# Retrieval-stack knobs (validated via Opik experiments).
# MULTI_QUERY_N=4
# K_RETRIEVE=10
# K_FINAL=5

# Eval harness.
# EVAL_SAMPLE_SIZE=50
# EVAL_DATASET_NAME=COVID-QA-full-stack
# EVAL_PARQUET_PATH=data/ragbench/covidqa/test-00000-of-00001.parquet
# INGEST_PARQUET_PATH=data/ragbench/covidqa/train-00000-of-00001.parquet

# API safety limits.
# MAX_QUERY_LEN=4096
# MAX_RPM_PER_SESSION=30
# MAX_PDF_SIZE_MB=25
# MAX_PDF_PAGES=10           # per-file page cap
# MAX_PDFS_PER_USER=5        # per-user document cap
# Set to false to see raw PHI in chat_history for local debugging.
REDACT_PII=true

# --- Auth / eval stores (sqlite, single-process) ---
# AUTH_DB_PATH=data/users.sqlite
# EVAL_DB_PATH=data/eval.sqlite

# --- CORS (frontend origin; comma-separated) ---
CORS_ORIGINS=http://localhost:3000


# === Phase 4: async ingestion pipeline (SQS + in-process worker) ===
# Only ONE AWS service in this design: SQS. PDF bytes stay on local disk;
# job status in a tiny sqlite file; ingestion happens in a background thread
# inside the FastAPI process (no Lambda, no ECS fleet). If SQS_QUEUE_URL is
# blank or INGEST_WORKER_ENABLED=false, /ingest/pdf falls back to inline
# synchronous ingest (handy for local dev without a queue set up).
INGEST_WORKER_ENABLED=true

# AWS region + (optional) explicit creds; if you leave these blank, boto3
# walks its default chain (~/.aws/credentials, env, IAM role).
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# S3 bucket for presigned upload URLs. When set, the frontend uploads files
# directly to S3 (no AWS creds exposed); the worker downloads from S3.
# Leave blank for the legacy multipart fallback (local disk).
S3_BUCKET_NAME=
# Optional endpoint for Localstack-style local dev. Blank = real AWS.
# S3_ENDPOINT_URL=http://localhost:4566
# Presigned URL expiry in seconds.
# S3_PRESIGN_EXPIRY=3600

# SQS Standard queue URL. Required when INGEST_WORKER_ENABLED=true.
# Leave blank to keep the inline-sync fallback.
SQS_QUEUE_URL=

# SQS knobs.
# SQS_VISIBILITY_TIMEOUT_SEC=600   # one-PDF worst-case on a laptop CPU
# SQS_WAIT_SECONDS=20               # long-poll max
# SQS_MAX_MESSAGES=1               # worker concurrency (1 = don't starve /ask)
# SQS_MAX_ATTEMPTS=5
# Endpoint override — for Localstack-style local dev. Blank = real AWS.
# SQS_ENDPOINT_URL=http://localhost:4566

# Local disk layout.
# INGEST_UPLOAD_DIR=data/uploads
# INGEST_STATUS_DB_PATH=data/ingest_jobs.sqlite
# File types accepted by POST /ingest/pdf (loader registry dispatches by ext).
# INGEST_SUPPORTED_EXTENSIONS=pdf,txt,md,png,jpg,jpeg
# Set false to delete the PDF after the worker upserts its chunks (frees
# the disk; chunks live on in Qdrant). Default true keeps the file for
# source-citation follow-ups and debugging.
# INGEST_KEEP_PDF_AFTER_SUCCESS=true
